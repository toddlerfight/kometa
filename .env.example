# Copy to .env (gitignored) and fill in. Never commit real values — this repo is public.

# Komga
KOMGA_URL=http://your-nas-host:8585
KOMGA_USER=your@email.com
KOMGA_PASS=yourpassword
KOMGA_LIBRARY_ID=yourkomgalibraryid

# Metadata sources
METRON_USER=yourusername
METRON_PASS=yourpassword
CV_API_KEY=yourcomicvinekey

# Scheduler
KOMETA_SYNC_HOURS=5,12,17

# Deploy target (used by deploy.sh)
KOMETA_HOST=your-host
KOMETA_USER=youruser
KOMETA_PORT=22
KOMETA_KEY=~/.ssh/your_key
# Tailscale MagicDNS hostname, for deploying off-LAN (the <host>.<tailnet> name)
KOMETA_TS_HOST=
# Dir on the host that the kometa/ package bind-mounts out of
KOMETA_APP_DIR=/path/to/apps/kometa
# Dir holding docker-compose.yml (defaults to KOMETA_APP_DIR)
KOMETA_COMPOSE_DIR=/path/to/compose
# Absolute path to the docker binary if it isn't on PATH over ssh
KOMETA_DOCKER=docker
